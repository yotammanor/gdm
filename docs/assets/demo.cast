{"version": 2, "width": 100, "height": 32, "timestamp": 1788919754, "title": "GDM CLI \u2014 actual local recording (no network)", "env": {"SHELL": "/bin/zsh", "TERM": "xterm-256color"}}
[0.0, "o", "\r\n# gdm --help\r\n"]
[0.2, "o", "                                                                                \r\n"]
[0.26, "o", " Usage: gdm [OPTIONS] COMMAND [ARGS]...                                         \r\n"]
[0.32, "o", "                                                                                \r\n"]
[0.38, "o", " Google Drive Model \u2014 inspect, infer, migrate, and index Drive-backed data.     \r\n"]
[0.44, "o", "                                                                                \r\n"]
[0.5, "o", "\u256d\u2500 Options \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\r\n"]
[0.56, "o", "\u2502 --project-dir                      <path>  Local project directory           \u2502\r\n"]
[0.6200000000000001, "o", "\u2502                                            containing .gdm metadata.         \u2502\r\n"]
[0.6800000000000002, "o", "\u2502                                            [env var: GDM_PROJECT_DIR]        \u2502\r\n"]
[0.7400000000000002, "o", "\u2502 --dry-run               --apply            Default to inspection-only mode;  \u2502\r\n"]
[0.8000000000000003, "o", "\u2502                                            use --apply to mutate.            \u2502\r\n"]
[0.8600000000000003, "o", "\u2502                                            [default: dry-run]                \u2502\r\n"]
[0.9200000000000004, "o", "\u2502 --install-completion                       Install completion for the        \u2502\r\n"]
[0.9800000000000004, "o", "\u2502                                            current shell.                    \u2502\r\n"]
[1.0400000000000005, "o", "\u2502 --show-completion                          Show completion for the current   \u2502\r\n"]
[1.1000000000000005, "o", "\u2502                                            shell, to copy it or customize    \u2502\r\n"]
[1.1600000000000006, "o", "\u2502                                            the installation.                 \u2502\r\n"]
[1.2200000000000006, "o", "\u2502 --help                                     Show this message and exit.       \u2502\r\n"]
[1.2800000000000007, "o", "\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\r\n"]
[1.3400000000000007, "o", "\u256d\u2500 Commands \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\r\n"]
[1.4000000000000008, "o", "\u2502 init     Initialize local .gdm project scaffolding (metadata only by         \u2502\r\n"]
[1.4600000000000009, "o", "\u2502          default).                                                           \u2502\r\n"]
[1.520000000000001, "o", "\u2502 explore  Inventory a Drive root and report collection candidates without     \u2502\r\n"]
[1.580000000000001, "o", "\u2502          content reads.                                                      \u2502\r\n"]
[1.640000000000001, "o", "\u2502 adopt    Bind a folder as a collection model (dry-run by default).           \u2502\r\n"]
[1.700000000000001, "o", "\u2502 doctor   Reconcile collection membership/metadata without reading file       \u2502\r\n"]
[1.7600000000000011, "o", "\u2502          bodies.                                                             \u2502\r\n"]
[1.8200000000000012, "o", "\u2502 migrate  Plan and apply schema migrations.                                   \u2502\r\n"]
[1.8800000000000012, "o", "\u2502 index    Sidecar index maintenance.                                          \u2502\r\n"]
[1.9400000000000013, "o", "\u2502 auth     Authentication helpers.                                             \u2502\r\n"]
[2.0000000000000013, "o", "\u2502 infer    Infer GDM models from Drive metadata or local samples.              \u2502\r\n"]
[2.0600000000000014, "o", "\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\r\n"]
[2.1200000000000014, "o", "\r\n"]
[2.1700000000000013, "o", "\r\n"]
[2.220000000000001, "o", "\r\n# gdm infer file (local JSON)\r\n"]
[2.4200000000000013, "o", "Binding proposal (local content sample)\r\n"]
[2.4800000000000013, "o", "  storage: file\r\n"]
[2.5400000000000014, "o", "  resource_hint: Bind to a JSON Drive file with explicit codec.\r\n"]
[2.6000000000000014, "o", "\r\n"]
[2.6500000000000012, "o", "Generated model\r\n"]
[2.7100000000000013, "o", "from __future__ import annotations\r\n"]
[2.7700000000000014, "o", "\r\n"]
[2.820000000000001, "o", "from gdm import GDMModel, Field\r\n"]
[2.8800000000000012, "o", "\r\n"]
[2.930000000000001, "o", "\r\n"]
[2.980000000000001, "o", "class SampleDoc(GDMModel, storage=\"file\", mime=\"json\", codec=\"json\", mapping=\"partial\"):\r\n"]
[3.040000000000001, "o", "    \"\"\"Inferred json model; review before binding.\"\"\"\r\n"]
[3.100000000000001, "o", "\r\n"]
[3.150000000000001, "o", "    title: str = Field(..., source=\"title\")\r\n"]
[3.210000000000001, "o", "    campaign: str = Field(..., source=\"campaign\")\r\n"]
[3.270000000000001, "o", "    approved: bool = Field(..., source=\"approved\")\r\n"]
[3.330000000000001, "o", "\r\n"]
[3.380000000000001, "o", "\r\n"]
[3.4300000000000006, "o", "\r\n# gdm init (local metadata only)\r\n"]
[3.630000000000001, "o", "Initialized GDM project metadata at \r\n"]
[3.690000000000001, "o", "/private/var/folders/65/d5hskp050g5cwx0lhfvx704m0000gp/T/tmp.CbH1SxMf6A/.gdm\r\n"]
[3.750000000000001, "o", "Drive root binding is local metadata only; no remote mutation performed.\r\n"]
[3.810000000000001, "o", "\r\n"]
[3.8600000000000008, "o", "\r\n# gdm doctor (local)\r\n"]
[4.0600000000000005, "o", "No schema snapshots found.\r\n"]
[4.12, "o", "Sidecar indexes: 0 file(s)\r\n"]
[4.18, "o", "Doctor checks completed (metadata-only).\r\n"]
[4.239999999999999, "o", "\r\n"]
[4.289999999999999, "o", "\r\n# gdm adopt (dry-run)\r\n"]
[4.489999999999999, "o", "Adopt plan\r\n"]
[4.549999999999999, "o", "  metadata_only: True\r\n"]
[4.6099999999999985, "o", "  destructive: False\r\n"]
[4.669999999999998, "o", "  would: registry: bind folder ID to model\r\n"]
[4.729999999999998, "o", "  would: metadata-store: ensure collection metadata storage exists\r\n"]
[4.789999999999997, "o", "Adoption binds folder membership and metadata; it does not download or rewrite \r\n"]
[4.849999999999997, "o", "native file content.\r\n"]
[4.909999999999997, "o", "Existing members remain untouched; GDM adds routing appProperties only to \r\n"]
[4.969999999999996, "o", "members it creates or explicitly retags.\r\n"]
[5.029999999999996, "o", "Use explicit move/trash/content APIs for destructive changes.\r\n"]
[5.089999999999995, "o", "Dry-run: no Drive or Sheets writes performed.\r\n"]
[5.149999999999995, "o", "\r\n"]
[5.199999999999995, "o", "\r\n# gdm index rebuild (dry-run)\r\n"]
[5.399999999999995, "o", "Dry-run (metadata-only): would rebuild index for CampaignAsset.campaign with \r\n"]
[5.459999999999995, "o", "fingerprint 026ee02eb384\u2026 (policy=rebuild)\r\n"]
[5.519999999999994, "o", "\r\n"]
